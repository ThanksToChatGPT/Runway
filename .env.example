# PostgreSQL
POSTGRES_USER=outfit_user
POSTGRES_PASSWORD=outfit_pass
POSTGRES_DB=outfit_builder
DATABASE_URL=postgresql://outfit_user:outfit_pass@db:5432/outfit_builder

# Backend
PORT=4000
JWT_SECRET=change_me_in_production_min_32_characters
SCRAPER_URL=http://scraper:8000
SCRAPER_TIMEOUT_MS=15000
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:3000
# Seed de admin (npm run seed:admin; defaults en desarrollo: admin@outfitbuilder.local / Admin1234)
# ADMIN_EMAIL=admin@outfitbuilder.local
# ADMIN_PASSWORD=Admin1234
# ADMIN_NAME=Administrador

# Scraper (usa también SCRAPER_TIMEOUT_MS para calcular su presupuesto de tiempo)
SCRAPER_MAX_PRODUCTS=150
SCRAPER_IMAGE_ANALYSIS=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
