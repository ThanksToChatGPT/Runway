# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_SSL=true
DB_POOL_MAX=5

# Backend
PORT=4000
JWT_SECRET=replace_with_a_secure_random_secret
SCRAPER_URL=http://scraper:8000
SCRAPER_TIMEOUT_MS=15000
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:3000
# Seed de admin (npm run seed:admin; defaults en desarrollo: admin@outfitbuilder.local / Admin1234)
# ADMIN_EMAIL=admin@outfitbuilder.local
# ADMIN_PASSWORD=Admin1234
# ADMIN_NAME=Administrador

# Scraper
SCRAPER_MAX_PRODUCTS=150
SCRAPER_IMAGE_ANALYSIS=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
