{
  "name": "outfit-builder-backend",
  "version": "0.1.0",
  "description": "Outfit Builder MVP Backend (Hexagonal Ports & Adapters)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed:admin": "node src/seedAdmin.js",
    "test": "node --test",
    "test:core": "node --test \"src/tests/{domain,ports,services}/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" \"src/tests/{domain,ports,services}/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
